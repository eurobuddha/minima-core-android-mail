<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Node-only: no INTERNET permission. All data comes from the local Minima Core node over the
         broadcast-Intent IPC. Package visibility lets us launch the node app + deliver targeted broadcasts. -->
    <queries>
        <package android:name="org.minimarex.minimacore" />
    </queries>

    <!-- New-mail notifications (Android 13+ prompts at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scan a contact's Mail-key QR. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- allowBackup=false is a FUND-SAFETY setting here, not a preference. With the scaffold default
         (true + empty rules) Android Auto Backup uploaded this app's whole data directory to the user's
         cloud and RESTORED it on reinstall — which both exfiltrates the data below and re-plants state a
         reinstall is supposed to clear. A reinstall must be a true reset.
         At stake: minima_mail.db — decrypted plaintext message bodies, subjects and images — plus meta "mypayaddr",
         which is advertised in the contact card and on every outgoing message. This app already ships a
         proper passphrase-encrypted export; Auto Backup only undermined it -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Utxo"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
