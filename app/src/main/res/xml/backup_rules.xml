<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules.

   NOTHING in this app may leave the device. allowBackup="false" already disables this, but the excludes are
   explicit so the intent survives anyone flipping that flag back. What is at stake here:
   minima_mail.db — decrypted plaintext message bodies, subjects and images — plus meta "mypayaddr",
         which is advertised in the contact card and on every outgoing message. This app already ships a
         proper passphrase-encrypted export; Auto Backup only undermined it
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
